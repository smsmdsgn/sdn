					},
				],
			},
			{
				heading: "基本オブジェクト",
				items: [
					{
						label: "Object",
						href: "/ja/js/reference/global-object/object/",
					},
				],
			},
			{
				heading: "エラーオブジェクト",
				items: [
					{
						label: "Error",
						href: "/ja/js/reference/global-object/error/",
