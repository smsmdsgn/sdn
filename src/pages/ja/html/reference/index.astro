---
import Layout from "../../../../layouts/Layout.astro";
import SectionIndex from "../../../../components/SectionIndex.astro";

const title = "リファレンス";

const groups = [
	{
		heading: "要素",
		items: [
			{
				label: "header",
				href: "/ja/html/reference/element/header/",
			},
		],
	},
	{
		heading: "属性",
		items: [
			{
				label: "loading",
				href: "/ja/html/reference/attribute/loading/",
			},
		],
	},
];
---

<Layout title={title}>
	<SectionIndex title={title}>
		<h2>索引</h2>
		{
			groups.map((group) => (
				<>
					<h3>{group.heading}</h3>
					<ul>
						{group.items.map((item) => (
							<li>
								<a href={item.href}>{item.label}</a>
							</li>
						))}
					</ul>
				</>
			))
		}
	</SectionIndex>
</Layout>
