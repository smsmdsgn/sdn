				label: "キャプチャグループ",
				href: "/ja/js/reference/regular-expression/capturing-group/",
			},
		],
	},
];
---

<Layout title={title}>
	<SectionIndex title={title}>
		{
			sections.map((section) => (
				<section>
					<h2>{section.heading}</h2>
					{section.groups ? (
						section.groups.map((group) => (
							<>
								<h3>{group.heading}</h3>
								<ul>
									{group.items.map((item) => (
										<li>
											<a href={item.href}>{item.label}</a>
										</li>
									))}
								</ul>
							</>
						))
					) : (
						<ul>
							{section.items?.map((item) => (
								<li>
									<a href={item.href}>{item.label}</a>
								</li>
							))}
						</ul>
					)}
				</section>
			))
		}
	</SectionIndex>
</Layout>
