				],
			},
		],
	},
	{
		heading: "関数",
		items: [
			{
				label: "アロー関数",
				href: "/ja/js/reference/function/allow-function/",
			},
			{
				label: "デフォルト引数",
				href: "/ja/js/reference/function/default-parameter/",
			},
			{
				label: "残余引数",
				href: "/ja/js/reference/function/rest-parameter/",
			},
			{
				label: "arguments",
				href: "/ja/js/reference/function/arguments/",
			},
			{
				label: "メソッド定義",
				href: "/ja/js/reference/function/method-definition/",
			},
			{
				label: "ゲッター",
				href: "/ja/js/reference/function/get/",
			},
			{
				label: "セッター",
				href: "/ja/js/reference/function/set/",
			},
		],
	},
	{
		heading: "クラス",
		items: [
			{
				label: "コンストラクタ",
				href: "/ja/js/reference/class/constructor/",
			},
			{
				label: "継承（extends）",
				href: "/ja/js/reference/class/extends/",
			},
			{
				label: "プライベート要素",
				href: "/ja/js/reference/class/private-element/",
