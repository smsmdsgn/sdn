				],
			},
			{
				heading: "その他",
				items: [
					{
						label: "空文",
						href: "/ja/js/reference/statement/empty/",
					},
				],
			},
		],
	},
	{
		heading: "式と演算子",
		groups: [
			{
				heading: "主な式",
				items: [
					{
						label: "this",
						href: "/ja/js/reference/operator/this/",
