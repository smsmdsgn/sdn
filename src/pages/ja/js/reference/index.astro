				],
			},
			{
				heading: "構造化データ",
				items: [
					{
						label: "ArrayBuffer",
						href: "/ja/js/reference/global-object/array-buffer/",
					},
				],
			},
			{
				heading: "メモリ管理",
				items: [
					{
						label: "WeakRef",
