			{
				heading: "yield演算子",
				items: [
					{
						label: "yield演算子",
						href: "/ja/js/reference/operator/yield/",
					},
				],
			},
			{
				heading: "スプレッド構文",
				items: [
					{
						label: "スプレッド構文（...）",
