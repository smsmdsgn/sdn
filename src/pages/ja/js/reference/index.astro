				],
			},
			{
				heading: "関係演算子",
				items: [
					{
						label: "小なり演算子（<）",
						href: "/ja/js/reference/operator/less-than/",
					},
				],
			},
			{
				heading: "等価演算子",
				items: [
					{
						label: "等価演算子（==）",
