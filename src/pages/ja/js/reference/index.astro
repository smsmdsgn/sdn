---
import Layout from "../../../../layouts/Layout.astro";
import SectionIndex from "../../../../components/SectionIndex.astro";

const title = "リファレンス";

const sections = [
	{
		heading: "組み込みオブジェクト",
		groups: [
			{
				heading: "値プロパティ",
